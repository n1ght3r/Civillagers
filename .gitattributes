* text=auto
*.sh text eol=lf
gradlew text eol=lf
*.bat text eol=crlf
*.ps1 text eol=crlf
# checkDatagen asks git whether the files datagen just wrote differ from what is committed, so the
# checkout has to match what datagen writes, on every platform. Datagen writes LF.
src/main/generated/** text eol=lf

*.png binary
*.jar binary
*.nbt binary
