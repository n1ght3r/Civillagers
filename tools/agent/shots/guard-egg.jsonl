// The Villager Guard Spawn Egg in the player's hand and in the hotbar, captured for a person to look at.
//     python tools/agent/new_world.py <node> GuardsAgent
//     ./gradlew ":<node>:runClient" -Pagent=tools/agent/shots/guard-egg.jsonl -Pquickplay=GuardsAgent
//     python tools/agent/drive.py run/<node>/agent/client tools/agent/shots/guard-egg.jsonl --verify --max-age 10
// The capture lands in run/<node>/agent/client/screenshots/guard-egg.png.
{"id": "probe", "command": "probe", "expect": {"ok": true, "result.side": "client"}}
{"id": "join", "command": "wait", "args": {"ticks": 300}}
{"id": "inworld", "command": "client.info", "expect": {"ok": true, "result.inWorld": true, "result.mouseGrabbed": false}}
{"id": "egg", "command": "server.command", "args": {"command": "item replace entity @s hotbar.0 with civillagers:guard_spawn_egg", "as": "@only"}, "expect": {"ok": true}}
{"id": "select", "command": "server.command", "args": {"command": "item replace entity @s hotbar.1 with minecraft:villager_spawn_egg", "as": "@only"}, "expect": {"ok": true}}
{"id": "level", "command": "client.look", "args": {"pitch": 20}}
{"id": "draw", "command": "wait", "args": {"ticks": 20}}
{"id": "capture", "command": "client.capture", "args": {"name": "guard-egg"}, "expect": {"ok": true}}
